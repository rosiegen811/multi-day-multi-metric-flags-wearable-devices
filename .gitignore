# Secrets (WHOOP OAuth keys)
.env

# Real wearable data: never commit
data/raw/*
!data/raw/.gitkeep

# Session recordings: never commit
data/sessions/*
!data/sessions/.gitkeep

# Personal WHOOP export: never commit (keep local only)
data/whoop/*
!data/whoop/.gitkeep

# Generated data: rebuild from simulate.py instead
data/*.csv

# WHOOP-derived outputs: personal, keep local only
output/whoop_*.png
output/whoop_*.csv

# Python and Jupyter clutter
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.hypothesis/

# Local virtual environments
.venv/
venv/
